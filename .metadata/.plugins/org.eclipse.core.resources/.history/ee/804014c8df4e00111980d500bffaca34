#ifndef BUFFERS_EXPIRATION_H
#define BUFFERS_EXPIRATION_H

#include <string>
#include <vector>
#include <algorithm>
#include <omnetpp.h>

using namespace omnetpp;

// --- Definiciones Globales ---

enum Priority {
    P_EMERGENCY = 0, // 1: Inmediato
    P_TRAFFIC = 1,   // 2: 30s
    P_AIR = 2,       // 3: 40s (ajustado según tu último mensaje)
    P_GPS = 3,       // 4: 50s
    P_OTHER = 4      // 5: 60s
};

struct QueuedData {
    std::string data;
    Priority prio;
    simtime_t timestamp;
};

struct QueueState {
    int p1, p2, p3, p4, p5;
};

// --- Clase SDCardBuffer (Gestión de Almacenamiento y Caducidad) ---

class SDCardBuffer {
private:
    static const int NUM_PRIORITIES = 5;
    static const int MAX_PER_PRIO = 2000;

    struct SDEntry {
        std::string content;
        simtime_t arrivalTime;
    };

    SDEntry buffer[NUM_PRIORITIES][MAX_PER_PRIO];
    int head[NUM_PRIORITIES] = {0,0,0,0,0};
    int tail[NUM_PRIORITIES] = {0,0,0,0,0};
    int count[NUM_PRIORITIES] = {0,0,0,0,0};

    // Tiempos máximos de espera por prioridad
    const double maxWaitTime[NUM_PRIORITIES] = {0.0, 30.0, 40.0, 50.0, 60.0};

public:
    void pushBatch(const std::vector<QueuedData>& batch) {
        for (const auto& item : batch) {
            int p = (int)item.prio;
            if (count[p] == MAX_PER_PRIO) {
                tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                count[p]--;
            }
            buffer[p][head[p]] = {item.data, item.timestamp};
            head[p] = (head[p] + 1) % MAX_PER_PRIO;
            count[p]++;
        }
    }

    QueueState get_size_queues() const {
        return {count[0], count[1], count[2], count[3], count[4]};
    }

    int get_number_data_on_sdcard() const {
        return count[0]+count[1]+count[2]+count[3]+count[4];
    }

    // Verifica si hay datos que expirarán antes de llegar al próximo punto WiFi
    bool hasExpiredData(simtime_t currentTime) {
        for (int p = 0; p < NUM_PRIORITIES; p++) {
            if (count[p] > 0) {
                if (p == 0 || (currentTime - buffer[p][tail[p]].arrivalTime >= maxWaitTime[p]))
                    return true;
            }
        }
        return false;
    }

    // Extrae datos basados puramente en la caducidad (EDF)
    std::vector<std::string> popBatch(int n, simtime_t currentTime, double time_until_next_AP, bool isWifi) {
        std::vector<std::string> result;
        simtime_t horizon = currentTime + time_until_next_AP;

        bool foundAny = true;
        while (result.size() < n && foundAny) {
            foundAny = false;
            for (int p = 0; p < NUM_PRIORITIES; p++) {
                if (count[p] > 0) {
                    simtime_t expirationTime = buffer[p][tail[p]].arrivalTime + maxWaitTime[p];

                    // Criterio de extracción: P1, WiFi activo o Caducidad inminente
                    bool mustSend = (p == 0) || isWifi || (expirationTime <= horizon);

                    if (mustSend) {
                        result.push_back(buffer[p][tail[p]].content);
                        tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                        count[p]--;
                        foundAny = true;
                        if (result.size() >= n) return result;
                    }
                }
            }
        }
        return result;
    }

    int totalSize() const {
        int total = 0;
        for(int i=0; i<NUM_PRIORITIES; i++) total += count[i];
        return total;
    }
};

// --- Clase InputBuffer (Acumulación Temporal) ---

class InputBuffer {
private:
    static const int MAX = 20;
    std::vector<QueuedData> buffer;

public:
    bool add(const std::string& data, Priority prio, simtime_t now) {
        buffer.push_back({data, prio, now});
        return buffer.size() >= MAX;
    }

    std::vector<QueuedData> flush() {
        std::vector<QueuedData> temp = buffer;
        buffer.clear();
        return temp;
    }

    int size() const { return buffer.size(); }
};

// --- Clase OutputBuffer (Gestión de Envío TCP) ---

class OutputBuffer {
private:
    std::vector<std::string> buffer;

public:
    void load(const std::vector<std::string>& dataVec) {
        buffer = dataVec;
    }

    bool isEmpty() const { return buffer.empty(); }

    std::string getOne() {
        if (buffer.empty()) return "";
        std::string data = buffer.front();
        buffer.erase(buffer.begin());
        return data;
    }

    int size() const { return buffer.size(); }
};

#endif
