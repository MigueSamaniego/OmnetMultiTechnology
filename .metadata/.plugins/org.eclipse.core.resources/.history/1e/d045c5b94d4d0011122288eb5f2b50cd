#ifndef BUFFERS_H
#define BUFFERS_H

#include <string>
#include <vector>
#include <algorithm>

using namespace omnetpp;

// --------------------------------------------------------------]
// ----------------- memmory management--------------------------]
// --------------------------------------------------------------]

enum Priority {
    P_EMERGENCY = 0, // 1: Inmediato
    P_TRAFFIC = 1,   // 2: 30s
    P_AIR = 2,       // 3: 5min
    P_GPS = 3,       // 4: 10min
    P_OTHER = 4      // 5: 20min
};

class SDCardBuffer {
private:
    static const int NUM_PRIORITIES = 5;
    static const int MAX_PER_PRIO = 2000;

    struct SDEntry {
        std::string content;
        simtime_t arrivalTime;
    };

    SDEntry buffer[NUM_PRIORITIES][MAX_PER_PRIO];
    int head[NUM_PRIORITIES] = {0,0,0,0,0};
    int tail[NUM_PRIORITIES] = {0,0,0,0,0};
    int count[NUM_PRIORITIES] = {0,0,0,0,0};

    const double maxWaitTime[NUM_PRIORITIES] = {0.0, 30.0, 300.0, 600.0, 1200.0};

    // weights to fill buffer output
    const float weights[NUM_PRIORITIES] = {0, 5.0, 3.0, 1.5, 0.5};

public:
    // --- Métodos de ingreso y estado ya conocidos ---
    void pushBatch(const std::vector<QueuedData>& batch, simtime_t now) {
        for (const auto& item : batch) {
            int p = (int)item.prio;
            if (count[p] == MAX_PER_PRIO) {
                tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                count[p]--;
            }
            buffer[p][head[p]] = {item.data, now};
            head[p] = (head[p] + 1) % MAX_PER_PRIO;
            count[p]++;
        }
    }

    QueueState get_size_queues() const {
        return {count[0], count[1], count[2], count[3], count[4]};
    }

    // --- MÉTODOS DE CONTROL DE SALIDA ---

    // 1. Verifica si hay alguna razón para disparar un envío
    bool hasExpiredData(simtime_t currentTime, bool isWifi) {
        if (isWifi && size() > 0) return true; // Si hay WiFi, vaciamos siempre

        for (int p = 0; p < NUM_PRIORITIES; p++) {
            if (count[p] > 0) {
                // P1 o cualquier dato que superó su tiempo
                if (p == 0 || (currentTime - buffer[p][tail[p]].arrivalTime >= maxWaitTime[p]))
                    return true;
            }
        }
        return false;
    }

    // 2. El nuevo popBatch de dos fases
    std::vector<std::string> popBatch(int n, simtime_t currentTime, bool isWifi) {
        std::vector<std::string> result;

        // --- FASE 1: extract all expiration data (MANDATORY) ---
        for (int p = 0; p < NUM_PRIORITIES; p++) {
            while (count[p] > 0 && result.size() < n) {
                bool mustSend = (p == 0) || isWifi ||
                                (currentTime - buffer[p][tail[p]].arrivalTime >= maxWaitTime[p]);

                if (mustSend) {
                    result.push_back(buffer[p][tail[p]].content);
                    tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                    count[p]--;
                } else {
                    break; // El siguiente dato de esta cola aún no expira
                }
            }
        }

        // --- FASE 2: RELLENO PROPORCIONAL (Si queda espacio) ---
        int available_space = result.size();
        int quota[5] = {0, 0, 0, 0, 0};

        if (available_space < n) {

            float Total_weight = 0;

            if (count[1] > 0){
                Total_weight+= weights[1];
                quota[1] = 1;
            }

            if (count[2] > 0){
                Total_weight+= weights[2];
                quota[2] = 1;
            }

            if (count[3] > 0){
                Total_weight+= weights[3];
                quota[3] = 1;
            }

            if (count[4] > 0){
                Total_weight+= weights[4];
                quota[4] = 1;
            }

            for(int k = 1; k<=4; k++){
                if(quota[k] > 0){
                    quota[k] = (int)((available_space * weights[k])/ Total_weight);
                }
            }

            int check_quota = quota[1] + quota[2] + quota[3] + quota[4];

            // re-distribution output Data
            if(check_quota == available_space){

                // start to fill buffer

            }else if(check_quota < available_space){

                // re-distribution output Buffer
                int last_available = available_space - check_quota;

                float Total_weight = 0;
                int re_fill[5] = {0, 0, 0, 0, 0};

                if (count[1] >= quota[1]){
                    Total_weight+= weights[1];
                    re_fill[1] = 1;
                }

                if (count[2] >= quota[2]){
                    Total_weight+= weights[2];
                    re_fill[2] = 1;
                }

                if (count[3] >= quota[3]){
                    Total_weight+= weights[3];
                    re_fill[3] = 1;
                }

                if (count[4] >= quota[4]){
                    Total_weight+= weights[4];
                    re_fill[4] = 1;
                }

                for(int k = 1; k<=4; k++){
                    if(re_fill[k] == 1){
                        quota[k] = (int)((last_available * weights[k])/ Total_weight);
                    }

                    int check_quota = quota[1] + quota[2] + quota[3] + quota[4];

                    if(check_quota)
                        break;

                }

                EV_INFO << "Buffer re calculation OK: " << "P1 :" <<  quota[1] << "P2 :" <<  quota[2] << "P3 :" <<  quota[3] << << "P4 :" <<  quota[4] << endl;

            }else if(check_quota > available_space){

                // it not should happening
                // stop simulation

            }



            bool addedAnyInCycle = true;
            while (result.size() < n && addedAnyInCycle) {
                addedAnyInCycle = false;

                // Empezamos desde P2 (P1 ya se vació en Fase 1)
                for (int p = 1; p < NUM_PRIORITIES; p++) {
                    // Intentamos sacar una cantidad de datos igual al peso
                    int weight = weights[p];
                    while (weight > 0 && count[p] > 0 && result.size() < n) {
                        result.push_back(buffer[p][tail[p]].content);
                        tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                        count[p]--;
                        weight--;
                        addedAnyInCycle = true;
                    }
                }
            }


        }
        return result;
    }

    int size() const {
        int total = 0;
        for(int i=0; i<NUM_PRIORITIES; i++) total += count[i];
        return total;
    }
};

class InputBuffer {
private:
    static const int MAX = 20;
    std::vector<QueuedData> buffer;

public:
    // Ahora el método add recibe la prioridad
    bool add(const std::string& data, Priority prio) {
        buffer.push_back({data, prio});
        return buffer.size() >= MAX;
    }

    std::vector<QueuedData> flush() {
        std::vector<QueuedData> temp = buffer;
        buffer.clear();
        return temp;
    }

    int size() const {
        return buffer.size();
    }

    int getCurrentBytes() const {
        int total = 0;
        for (const auto& item : buffer) {
            total += item.data.size();
        }
        return total;
    }
};

class OutputBuffer {
private:
    // El OutputBuffer ya no necesita saber de prioridades,
    // porque la SD ya le entregará los datos ordenados.
    std::vector<std::string> buffer;

public:
    void load(const std::vector<std::string>& dataVec) {
        buffer = dataVec;
    }

    bool hasData() const {
        return !buffer.empty();
    }

    std::string getOne() {
        if (buffer.empty()) return "";
        std::string data = buffer.front();
        buffer.erase(buffer.begin());
        return data;
    }

    bool isEmpty() const {
        return buffer.empty();
    }

    int size() const {
        return buffer.size();
    }
};

#endif
