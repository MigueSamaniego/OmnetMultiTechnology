package src.node_bus.apps;

import org.car2x.veins.subprojects.veins_inet.VeinsInetApplicationBase;

simple AppBusTCP_R_StateM_B extends VeinsInetApplicationBase
{
    parameters:
        
        int accident_start @unit(s) = default(1s);
        int accidentDuration @unit(s) = default(1s);
        double GW_Battery_Capacity_mAh @unit(mAh) = default(500mAh);
        int GW_Battery_Level_Start = default(100);
        bool event_accident = default(false);
        
        @display("i=block/app");
        @class(AppBusTCP_R_StateM_B);
        
        // Declaración de señales
        @signal[inputBufferSize](type="long");
        @signal[outputBufferSize_wifi](type="long");
        @signal[outputBufferSize_lte](type="long");
        @signal[sdcardBufferSize](type="long");
    	@signal[sdcardPercentSize](type="double");
    	
    	@signal[Packet_lose_deadline_signal](type="long");
    	@signal[Byte_lose_deadline_signal](type="long");
    	
    	@signal[outputBytesInterface_wifi](type="long");
    	@signal[outputBytesInterface_lte](type="long");
    	
    	@signal[GW_Battery_level](type="double");
    	
    	@signal[Consumption_WIFI_Battery](type="double");
    	@signal[Consumption_LTE_Battery](type="double");
    	
    	@signal[Time_TTD_Signal](type="double");
    	
    	@signal[RSSI_WIFI_level](type="double");
    	@signal[RSSI_LTE_level](type="double");
    	
    	@signal[Cost_Data_wifi_signal](type="double");
    	@signal[Cost_Data_lte_signal](type="double");
    	
    	@signal[buffer_priority_1](type="int");
    	@signal[buffer_priority_2](type="int");
    	@signal[buffer_priority_3](type="int");
    	@signal[buffer_priority_4](type="int");
    	@signal[buffer_priority_wifi](type="int");
    	
    	@signal[cost_wait_ap_signal](type="double");
    	@signal[cost_offloading_lte_signal](type="double");
    	@signal[cost_offloading_wifi_signal](type="double");
    	
    	
    	// time connection with interfaces
    	@signal[timeWiFiStateON](type="double");
    	@signal[timeLTEStateON](type="double");
    	
    	// Count udp messages sent
    	@signal[numMsgTCPSend](type="int");
    	@signal[numMsgTCPReceive](type="int");
    	
    	// RTT
    	@signal[timeRTT](type="double");
    	
    	// packet lost for saturation
    	@signal[Packet_lost_for_saturation_signal](type="long");
    	
    	// TCP ACK
    	//@signal[packetDataAcked](type="long");
    	
    	// --- REGISTRO OBLIGATORIO DE SEÑALES ---
        // 1. Señal para el RSRP Celular (Simu5G emite un tipo double)
        //@signal[servingCellRsrp](type="double");

        // 2. Señal para el WiFi Dimensional (INET emite un objeto tipo cObject)
        //@signal[receptionResult](type="omnetpp::cObject");

        
    	
    	
        // Configuración de estadísticas para que se graben como vectores
        @statistic[inputBufferSize](title="Input Buffer Size"; source="inputBufferSize"; record=vector,last);
        @statistic[outputBufferSize_wifi](title="Output Buffer Size Wifi"; source="outputBufferSize_wifi"; record=vector,last);
        @statistic[outputBufferSize_lte](title="Output Buffer Size LTE"; source="outputBufferSize_lte"; record=vector,last);
        @statistic[sdcardBufferSize](title="SDCard Buffer Size"; source="sdcardBufferSize"; record=vector,last,stats);
		//@statistic[sdcardUsage](title="SDCard used (%)"; source="sdcardPercentSize"; record=vector,last; interpolationmode=linear);
		@statistic[sdcardPercentSize](title="SDCard used (%)"; source="sdcardPercentSize"; record=vector,last,stats);
		
		@statistic[outputBytesInterface_wifi](title="Total Bytes Wifi"; source="outputBytesInterface_wifi"; record=vector,last);
		@statistic[outputBytesInterface_lte](title="Total Bytes LTE"; source="outputBytesInterface_lte"; record=vector,last);
		
		@statistic[Packet_lose_deadline_signal](title="Number Packet Lose"; source="Packet_lose_deadline_signal"; record=vector,last);
		@statistic[Byte_lose_deadline_signal](title="Bytes Lose [B]"; source="Byte_lose_deadline_signal"; record=vector,last);
		
		@statistic[GW_Battery_level](title="Battery Level mA/h"; source="GW_Battery_level"; record=last);
		
		@statistic[Consumption_WIFI_Battery](title="Current mA/h"; source="Consumption_WIFI_Battery"; record=vector,last);
		@statistic[Consumption_LTE_Battery](title="Current mA/h"; source="Consumption_LTE_Battery"; record=vector,last);
		
		@statistic[Time_TTD_Signal](title="TTD [s]"; source="Time_TTD_Signal"; record=vector,last);
		
		@statistic[RSSI_WIFI_level](title="RSSI WIFI [dBm]"; source="RSSI_WIFI_level"; record=vector,last);
		@statistic[RSSI_LTE_level](title="RSSI LTE [dBm]"; source="RSSI_LTE_level"; record=vector,last);
		
		@statistic[Cost_Data_wifi_signal](title="Cost WIFI [€]"; source="Cost_Data_wifi_signal"; record=last);
		@statistic[Cost_Data_lte_signal](title="Cost LTE [€]"; source="Cost_Data_lte_signal"; record=last);
		
		// number of messajes on sdcard size
		@statistic[buffer_priority_1](title="Buffer Priority Emergency"; source="buffer_priority_1"; record=vector,last,stats);
		@statistic[buffer_priority_2](title="Buffer Priority 2"; source="buffer_priority_2"; record=vector,last,stats);
		@statistic[buffer_priority_3](title="Buffer Priority 3"; source="buffer_priority_3"; record=vector,last,stats);
		@statistic[buffer_priority_4](title="Buffer Priority 4"; source="buffer_priority_4"; record=vector,last,stats);
		@statistic[buffer_priority_wifi](title="Buffer Priority WiFi"; source="buffer_priority_wifi"; record=vector,last,stats);
		
		@statistic[cost_wait_ap_signal](title="Cost to wait"; source="cost_wait_ap_signal"; record=vector,last,stats);
		@statistic[cost_offloading_lte_signal](title="Cost to use LTE"; source="cost_offloading_lte_signal"; record=vector,last,stats);
		@statistic[cost_offloading_wifi_signal](title="Cost to use WiFi"; source="cost_offloading_wifi_signal"; record=vectorlast,stats);
        
        
        @statistic[timeWiFiStateON](title= "WiFi Time Tx [s]"; source="timeWiFiStateON"; record=last,stats);
        @statistic[timeLTEStateON](title= "LTE Time Tx [s]"; source="timeLTEStateON"; record=last,stats);
        
        
        @statistic[numMsgTCPSend](title="TCP packet sent"; source="numMsgTCPSend"; record=last);
        @statistic[numMsgTCPReceive](title="TCP packet received"; source="numMsgTCPReceive"; record=last);
        
        @statistic[timeRTT](title="RTT (ms)"; source="timeRTT"; record=vector,count,last);
        
        @statistic[Packet_lost_for_saturation_signal](title="Packet Lose Saturation Memory"; source="Packet_lost_for_saturation_signal"; record=last);
        
        // (Opcional) Si quieres que OMNeT++ guarde las gráficas .vec automáticamente:
        //@statistic[servingCellRsrp](title="Celular RSRP"; source="servingCellRsrp"; record=vector);
        //@statistic[receptionPower](title="WiFi RSSI"; source="receptionPower"; record=vector);
        
    gates:

        
}
