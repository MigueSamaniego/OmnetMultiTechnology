void AppBusDataCollectionUDP::sendDataToCloud(){

    if(Vehicle_With_Interface){ // if the vehicle has interface

        // ----- check if buffer OutPut is Empty -------
        // ----- otherwise recovery data from SDCard ---
//        if (outputBuffer.isEmpty()) {
//            auto batch = sdcard.popBatch(20);
//            outputBuffer.load(batch);
//        }
        // -----
        if (outputBuffer.hasData()) {

            if(ConnectionToAP){

                std::string data = outputBuffer.getOne();
                emit(outputBufferSignal, outputBuffer.getCurrentBytes());
                //emit(outputBufferSignal, outputBuffer.size());

                auto payload = makeShared<AirPollutionMessage>();
                payload->setChunkLength(B(data.size())); // send X BYTES
                payload->setRawPayload(data.c_str());
                timestampPayload(payload);

                auto packet = createPacket("accident_car_test_UDP");

                packet->insertAtBack(payload);

                // send msg using interface GW established
                L3Address destAddr = L3AddressResolver().resolve("15.0.0.1"); // server address
                socket.sendTo(packet.release(), destAddr, 3000);
            }


        }else {
            // -------------- fill buffer OUTPUT AGAIN -----------------
            if (outputBuffer.isEmpty()) {
                auto batch = sdcard.popBatch(20);
                outputBuffer.load(batch);

                double currentBytes = (double)sdcard.getCurrentBytes();
                double usagePercent = (currentBytes / SDCARD_MAX_CAPACITY) * 100.0;

                if (usagePercent > 100.0) usagePercent = 100.0; // limitation visual error

                emit(sdcardPercentSignal, usagePercent);
                emit(sdcardBufferSignal, sdcard.getCurrentBytes());

            }

        }





    }

}

void AppBusDataCollectionUDP::interfaceAvailable(){

    if(ConnectionToAP){
        coun_msg_sent++;
        wifi->setState(NetworkInterface::State::UP);
        celular->setState(NetworkInterface::State::DOWN);


        EV_INFO << "CELLULAR disable → Using interfaz WIFI" << endl;

        auto rt = check_and_cast<Ipv4RoutingTable*>(getModuleByPath("^.ipv4.routingTable"));

        // delete default route previous
        for (int i = rt->getNumRoutes() - 1; i >= 0; --i) {
            auto route = rt->getRoute(i);
            if (route->getDestination().isUnspecified()) {
                rt->deleteRoute(route);
            }
        }

        // we update the routing table with WIFI domain like GW
        auto wlan0 = interfaceTable->findInterfaceByName("wlan0");
        auto def = new Ipv4Route();
        def->setDestination(Ipv4Address("0.0.0.0"));
        def->setNetmask(Ipv4Address("0.0.0.0"));
        def->setGateway(Ipv4Address("192.168.0.1"));
        def->setInterface(wlan0);
        def->setSourceType(Ipv4Route::MANUAL);
        rt->addRoute(def);

        EV_INFO << "Default route added via WIFI (gw=192.168.0.1)" << endl;

    }else {
        celular->setState(NetworkInterface::State::UP);
        wifi->setState(NetworkInterface::State::DOWN);
        EV_INFO << "WiFi disable → Using interfaz celular" << endl;

        auto rt = check_and_cast<Ipv4RoutingTable*>(getModuleByPath("^.ipv4.routingTable"));
        auto interfaceTable = getModuleFromPar<IInterfaceTable>(par("interfaceTableModule"), this);

        // limpiar default routes previas
        for (int i = rt->getNumRoutes() - 1; i >= 0; --i) {
            auto route = rt->getRoute(i);
            if (route->getDestination().isUnspecified()) {
                rt->deleteRoute(route);
            }
        }

        // we update the routing table with cellular domain like GW
        auto celular = interfaceTable->findInterfaceByName("cellular");
        auto def = new Ipv4Route();
        def->setDestination(Ipv4Address("0.0.0.0"));
        def->setNetmask(Ipv4Address("0.0.0.0"));
        def->setGateway(Ipv4Address("10.0.0.1"));
        def->setInterface(celular);
        def->setSourceType(Ipv4Route::MANUAL);
        rt->addRoute(def);

        EV_INFO << "Default route added via CELLULAR (gw=10.0.0.1)" << endl;

    }

}


inet::Coord AppBusDataCollectionUDP::convertXYtoLatLon(inet::Coord pos)
{
    //------------ calibration successfull----------------------- ----------------
    // it was maked because the 'mobility' object dont has the function (getCurrentPositionGeo)
    double x_min = 0.0;
    double y_min = 19063.42;    // traci recovery the position in way inverted
    double x_max = 10989.02;
    double y_max = 0.0;

    double lon_min = 16.186100;
    double lat_min = 39.234796;
    double lon_max = 16.313759;
    double lat_max = 39.408000;
    //---------------------------------------------------------------------------------------------
    //---------------  LAN and Long Calculation ---------------------------------------------------
    double lon = lon_min + ((pos.x - x_min) * (lon_max - lon_min) / (x_max - x_min));
    double lat = lat_min + ((pos.y - y_min) * (lat_max - lat_min) / (y_max - y_min));
    // ------------------ Modelling GPS ERROR with a ----------------------------------------------
    // ------------------ Normal Distribution  N(0,σ) ---------------------------------------------

    double sigma = 0.00005; // ~5-10 meters aprox

    static std::default_random_engine generator;
    static std::normal_distribution<double> distribution(0.0, sigma);

    double error_lat = distribution(generator);
    double error_lon = distribution(generator);

    lat += error_lat;
    lon += error_lon;

    return inet::Coord(lon, lat);
}



