package src.node_bus.cars;


// Módulo para vehículos que solo son "tráfico visual"
module NormalVehicle
{
    parameters:
        @display("i=veins/node/car;is=vs");
        string veinsmobilityType = default("src.node_bus.apps.VeinsInetMobility");
    submodules:
        // Solo movilidad, nada de nic ni appl
        mobility: <veinsmobilityType> like inet.mobility.contract.IMobility {
            parameters:
                @display("p=130,172;i=block/cogwheel");
        }
}