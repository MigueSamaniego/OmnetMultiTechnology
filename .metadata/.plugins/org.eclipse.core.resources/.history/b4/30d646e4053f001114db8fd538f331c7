bool AppBusDataCollectionTCP::startApplication()
{
    // this function is like 'main fuction'
    // here we can start timers
    if (!Control_Task_Timer) {
        // we are programming a message called 'controlTimer' it start a timer of 1 second,
        // when this time finish it sent himself the message to 'handleMessage(cMessage *msg)'
        Control_Task_Timer = new cMessage("Check_Tasks");
        scheduleAt(simTime() + SimTime(100, SIMTIME_MS), Control_Task_Timer); // the GW REQUIRE MORE TIME TO RECOVER INITIALITATION VARIABLES VALUES
    }

    return true;
}

bool AppBusDataCollectionTCP::stopApplication()
{
    if (Control_Task_Timer) {
        cancelAndDelete(Control_Task_Timer);
        Control_Task_Timer = nullptr;
    }

    // Llama a la función stopApplication base
    veins::VeinsInetApplicationBase::stopApplication();
    return true;
}

void AppBusDataCollectionTCP::finish()
{
    // Llama a la función finish base
    veins::VeinsInetApplicationBase::finish();

    if (SignStateConnectAP != 0) {
        cModule *wlanAgent = getParentModule()->findModuleByPath("wlan[0].agent");
        if (wlanAgent) {
             wlanAgent->unsubscribe(stateAssociationSignalId, this);
        }
    }
}

