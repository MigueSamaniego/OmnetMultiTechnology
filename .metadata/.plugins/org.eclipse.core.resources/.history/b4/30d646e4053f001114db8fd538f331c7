void AppBusDataCollectionTCP::stablishTCP()
{

    // 1. Si el socket ya está conectado o intentándolo, lo reiniciamos
    if (socket.getState() != inet::TcpSocket::NOT_BOUND && socket.getState() != inet::TcpSocket::CLOSED) {
        EV_INFO << "Cambiando de interfaz. Cerrando socket anterior..." << endl;
        socket.abort(); // abort() es más rápido que close() para cambios de interfaz
    }

    // 2. IMPORTANTE: Preparar el socket para una nueva conexión
    socket.renewSocket();

    // 3. Configurar la nueva IP de destino (el servidor sigue siendo el mismo)
    //inet::L3Address destAddress = inet::L3AddressResolver().resolve("server");
    inet::L3Address destAddress = inet::L3AddressResolver().resolve("15.0.0.1");
    int destPort = 3000;

    EV_INFO << "Intentando conectar por la nueva interfaz disponible..." << endl;
    socket.connect(destAddress, destPort);

}




