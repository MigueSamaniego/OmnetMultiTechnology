#ifndef BUFFERS_EXPIRATION_H
#define BUFFERS_EXPIRATION_H

#include <string>
#include <vector>
#include <algorithm>
#include <omnetpp.h>

using namespace omnetpp;

// --- Definiciones Globales ---

enum Priority {
    Priority_1 = 0, // 1: Inmediato
    Priority_2 = 1,   // 2: 60s
    Priority_3 = 2,       // 3: 10min (ajustado según tu último mensaje)
    Priority_4 = 3,       // 4: 00s no used
    Priority_wifi = 4      // 5: just wifi interface
};

struct QueuedData {
    std::string data;
    Priority prio;
    simtime_t timestamp;
};

struct QueueState {
    int p1, p2, p3, p4, p5;
};

struct RangeStats {
    int D_t;     // Número de paquetes en el rango
    size_t Bytes_total_on_range;    // Suma de caracteres de los paquetes en el rango
};

// --- Clase SDCardBuffer (Gestión de Almacenamiento y Caducidad) ---

class SDCardBuffer {
private:
    static const int NUM_PRIORITIES = 5;
    static const int MAX_PER_PRIO = 2000;

    struct SDEntry {
        std::string content;
        simtime_t arrivalTime;
    };

    SDEntry buffer[NUM_PRIORITIES][MAX_PER_PRIO];
    int head[NUM_PRIORITIES] = {0,0,0,0,0};
    int tail[NUM_PRIORITIES] = {0,0,0,0,0};
    int count[NUM_PRIORITIES] = {0,0,0,0,0};

    // Tiempos máximos de espera por prioridad
    const double maxWaitTime[NUM_PRIORITIES] = {2.0, 60.0, 900.0, 9600.0, 9650.0};

public:
    void pushBatch(const std::vector<QueuedData>& batch) {
        for (const auto& item : batch) {
            int p = (int)item.prio;
            if (count[p] == MAX_PER_PRIO) {
                tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                count[p]--;
            }
            buffer[p][head[p]] = {item.data, item.timestamp};
            head[p] = (head[p] + 1) % MAX_PER_PRIO;
            count[p]++;
        }
    }

    QueueState get_size_queues() const {
        return {count[0], count[1], count[2], count[3], count[4]};
    }

    long data_priority_on_sdcard() const {
        return count[0]+count[1]+count[2]+count[3]; //count[4] --> it is not priority
    }

    // Verifica si hay datos que expirarán antes de llegar al próximo punto WiFi
    bool hasExpiredData(simtime_t currentTime) {
        for (int p = 0; p < (NUM_PRIORITIES-1); p++) {// (NUM_PRIORITIES-1) it is not must to be consider, because priority only wifi use
            if (count[p] > 0) {
                if (p == 0 || (currentTime - buffer[p][tail[p]].arrivalTime >= maxWaitTime[p]))
                    return true;
            }
        }
        return false;
    }

    // Verifica si hay datos que expirarán antes de llegar al próximo punto WiFi
    double remaining_time(simtime_t currentTime) {

        double remaining_times_values[NUM_PRIORITIES];

        for (int p = 0; p < NUM_PRIORITIES; p++) {
            if (count[p] > 0) {
                remaining_times_values[p] =
                    maxWaitTime[p] - (currentTime - buffer[p][tail[p]].arrivalTime).dbl();
            } else {
                //remaining_times_values[p] = std::numeric_limits<double>::infinity();
                remaining_times_values[p] = 20000; // not values on memory
            }
        }

        return *std::min_element(
            remaining_times_values,
            remaining_times_values + NUM_PRIORITIES
        );
    }

    RangeStats getStatsByDeadline(simtime_t start, simtime_t end) const {
        int countInRange = 0;
        size_t sumChars = 0;

        for (int p = 0; p < NUM_PRIORITIES; p++) {
            int currentIndex = tail[p];
            for (int i = 0; i < count[p]; i++) {
                //EV_WARN << "count: " << p <<endl;
                // Calcula el índice real en el buffer circular
                int idx = (currentIndex + i) % MAX_PER_PRIO;
                //EV_WARN << "index: " << idx <<endl;
                // Calcula la deadline del paquete
                simtime_t deadline = buffer[p][idx].arrivalTime + maxWaitTime[p];

                //EV_WARN << "deadline calculado: " << deadline <<endl;

                // Verifica si la deadline cae en el rango [start, end]
                if (deadline >= start && deadline <= end) {
                    countInRange++;
                    sumChars += buffer[p][idx].content.length();
                }
            }
        }
        return {countInRange, sumChars};
    }

    // Extrae datos basados puramente en la caducidad (EDF)
    std::vector<std::string> popBatch(int n, simtime_t currentTime, double time_until_next_AP, bool isWifi) {
        std::vector<std::string> result;
        simtime_t horizon = currentTime + time_until_next_AP;

        bool foundAny = true;
        while (result.size() < n && foundAny) {
            foundAny = false;
            if(isWifi){
                // ************** FIRST recovery data priority to send ******************************************
                for (int p = 0; p < NUM_PRIORITIES-1; p++) {
                    if (count[p] > 0) {
                        simtime_t expirationTime = buffer[p][tail[p]].arrivalTime + maxWaitTime[p];

                        // Criterio de extracción: P1, WiFi activo o Caducidad inminente
                        bool mustSend = (p == 0) || isWifi || (expirationTime <= horizon);

                        if (mustSend) {
                            result.push_back(buffer[p][tail[p]].content);
                            tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                            count[p]--;
                            foundAny = true;
                            if (result.size() >= n) return result;
                        }
                    }
                }
                //************** if WIFI continue available recovery data without priority to send **************
                if ((count[0] == 0)&&(count[1] == 0)&&(count[2] == 0)&&(count[3] == 0)) {
                    uint8_t p = NUM_PRIORITIES-1;
                    if (count[p] > 0) {
                        simtime_t expirationTime = buffer[p][tail[p]].arrivalTime + maxWaitTime[p];

                        // Criterio de extracción: P1, WiFi activo o Caducidad inminente
                        bool mustSend = (p == 0) || isWifi || (expirationTime <= horizon);

                        if (mustSend) {
                            result.push_back(buffer[p][tail[p]].content);
                            tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                            count[p]--;
                            foundAny = true;
                            if (result.size() >= n) return result;
                        }
                    }
                }

            }else {
                // ********************** recovery only data with priority ***********************
                for (int p = 0; p < (NUM_PRIORITIES-1); p++) {
                    if (count[p] > 0) {
                        simtime_t expirationTime = buffer[p][tail[p]].arrivalTime + maxWaitTime[p];

                        // Criterio de extracción: P1, WiFi activo o Caducidad inminente
                        bool mustSend = (p == 0) || isWifi || (expirationTime <= horizon);

                        if (mustSend) {
                            result.push_back(buffer[p][tail[p]].content);
                            tail[p] = (tail[p] + 1) % MAX_PER_PRIO;
                            count[p]--;
                            foundAny = true;
                            if (result.size() >= n) return result;
                        }
                    }
                }
            }
        }
        return result;
    }

    int totalSize() const {
        int total = 0;
        for(int i=0; i<NUM_PRIORITIES; i++) total += count[i];
        return total;
    }
};

// --- Clase InputBuffer (Acumulación Temporal) ---

class InputBuffer {
private:
    static const int MAX = 20;
    std::vector<QueuedData> buffer;

public:
    bool add(const std::string& data, Priority prio, simtime_t now) {
        buffer.push_back({data, prio, now});
        return buffer.size() >= MAX;
    }

    std::vector<QueuedData> flush() {
        std::vector<QueuedData> temp = buffer;
        buffer.clear();
        return temp;
    }

    int size() const { return buffer.size(); }
};

// --- Clase OutputBuffer (Gestión de Envío TCP) ---

class OutputBuffer {
private:
    std::vector<std::string> buffer;

public:
    void load(const std::vector<std::string>& dataVec) {
        buffer = dataVec;
    }

    bool isEmpty() const { return buffer.empty(); }

    std::string getOne() {
        if (buffer.empty()) return "";
        std::string data = buffer.front();
        buffer.erase(buffer.begin());
        return data;
    }

    int size() const { return buffer.size(); }
};

#endif
