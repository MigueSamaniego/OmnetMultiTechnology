bool AppBusTCP_R_StateM_B::startApplication()
{
    // this function is like 'main fuction'

    std::string vehicle = mobility->getExternalId();

    // check if vehicle from simulation is type Autobus
    if (vehicle.rfind("buses_cosenza.", 0) == 0) {

        //getParentModule()->getDisplayString().setTagArg("i", 0, "node/bus");// name
        getParentModule()->getDisplayString().setTagArg("i", 0, "node/bus_vs");
        getParentModule()->getDisplayString().setTagArg("is", 0, "");
        Vehicle_With_Interface = true;
    }


    // here we can start timers
    if (!Control_Task_Timer) {
        // we are programming a message called 'controlTimer' it start a timer of 1 second,
        // when this time finish it sent himself the message to 'handleMessage(cMessage *msg)'
        Control_Task_Timer = new cMessage("Check_Tasks");
        scheduleAt(simTime() + SimTime(100, SIMTIME_MS), Control_Task_Timer); // the GW REQUIRE MORE TIME TO RECOVER INITIALITATION VARIABLES VALUES

    }

    //if(Vehicle_With_Interface){

    //}

    return true;
}

bool AppBusTCP_R_StateM_B::stopApplication()
{
    if (Control_Task_Timer) {
        cancelAndDelete(Control_Task_Timer);
        Control_Task_Timer = nullptr;
    }

    // Llama a la función stopApplication base
    veins::VeinsInetApplicationBase::stopApplication();
    return true;
}

void AppBusTCP_R_StateM_B::finish()
{
    // 1. Llama a la función finish base de Veins/INET
    veins::VeinsInetApplicationBase::finish();

    cModule *host = getParentModule();

    if (SignStateConnectAP != 0) {
        cModule *wlanAgent = host->findModuleByPath(".wlan[0].agent");
        if (wlanAgent) {
            wlanAgent->unsubscribe(stateAssociationSignalId, this);
            EV_INFO << "Cancelada suscripción de Asociación en " << wlanAgent->getFullPath() << endl;
        }
    }

    cModule *wlanRadio = host->findModuleByPath(".wlan[0].radio");
    if (wlanRadio) {
        wlanRadio->unsubscribe(RSSI_WIFI_iD, this);
        EV_INFO << "Cancelada suscripción de RSSI WiFi en " << wlanRadio->getFullPath() << endl;
    }

    cModule *ltePhy = host->findModuleByPath(".cellularNic.phy");
    if (ltePhy) {
        ltePhy->unsubscribe(RSSI_LTE_iD, this);
        EV_INFO << "Cancelada suscripción de RSSI LTE en " << ltePhy->getFullPath() << endl;
    }

    cModule *localTcp = host->findModuleByPath(".tcp");
    if (localTcp) {
        localTcp->unsubscribe(L4_ACK_iD, this);
        EV_INFO << "Cancelada suscripción de L4_ACK_iD en " << localTcp->getFullPath() << endl;
    }

}

