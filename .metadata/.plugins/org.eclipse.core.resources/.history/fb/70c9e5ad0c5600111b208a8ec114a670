import simu5g.stack.ICellularNic;

//import src.node_bus.configurators.DualStackAutoConfigurator;

import org.car2x.veins.base.modules.*;

// 
// Car Module
//
module BusGW extends Ue
{
    parameters:
        int numWlanInterfaces = default(0);
        
        // ¡NUEVO PARÁMETRO! Por defecto los buses sí tendrán celular
        bool hasCellular = default(true);
        
        @display("is=s;i=node/car");

        mobility.typename = default("VeinsInetMobility");

        *.interfaceTableModule = default(absPath(".interfaceTable"));
        *.routingTableModule = default("^.^.ipv4.routingTable");

    gates:
        input wlanRadioIn[numWlanInterfaces] @directIn;  // nuevo gate solo para WiFi

    submodules:
        
        wlan[numWlanInterfaces]: <default("Ieee80211Interface")> like IWirelessInterface {
            	@display("p=283.764,495.92398,row,150;q=queue");
        }

		// ¡SÚPER REGLA MAESTRA! Sobrescribimos el submódulo heredado del UE.
        // Si 'hasCellular' es falso, OMNeT++ destruirá este objeto por completo al nacer.
        cellularNic: <nicType> like ICellularNic if hasCellular {
            nodeType = parent.nodeType;
            @display("p=355.152,589.50397");
        }


    connections allowunconnected:
        // conexiones WiFi
        for i=0..numWlanInterfaces-1 {
            wlanRadioIn[i] --> wlan[i].radioIn;
            wlan[i].upperLayerOut --> nl.in++;
            wlan[i].upperLayerIn <-- nl.out++;
        }
}
