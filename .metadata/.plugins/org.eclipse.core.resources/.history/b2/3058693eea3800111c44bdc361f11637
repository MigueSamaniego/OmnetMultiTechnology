AppBusDataCollectionTCP::AppBusDataCollectionTCP()
{
    // Inicializar la bandera de suscripción
    SignStateConnectAP = false; // Usamos SignStateConnectAP como bandera de 'suscripción hecha'
    Control_Task_Timer = nullptr;
    ConnectionToAP = false;
}

AppBusDataCollectionTCP::~AppBusDataCollectionTCP()
{
}

// *****************************************************************
// 1. LÓGICA DE INICIALIZACIÓN (Registro de Señales)
// *****************************************************************

void AppBusDataCollectionTCP::initialize(int stage)
{
    // CALL INIZIALITATION BASE
    veins::VeinsInetApplicationBase::initialize(stage);

    // REGISTRATION NEW SIGNAL JUST IN THE initialitation 'STAGE'
    if (stage == INITSTAGE_APPLICATION_LAYER) {
        //EV_INFO << "Inicializando AppBusDataCollectionTCP en stage " << stage << endl;
        stateAssociationSignalId = registerSignal("stateAssociationSignal");

    }

}


// ----------------------------------------------------------------------
// 2. structure of signal for connection state with AP
// ----------------------------------------------------------------------
void AppBusDataCollectionTCP::receiveSignal(cComponent *source, simsignal_t signalID, long l, cObject *details)
{
    if (signalID == stateAssociationSignalId) {
        if(l>1){
            EV_ERROR << "ERROR: SIGNAL RECEIVED (stateAssociationSignalId) OUT RANGE."<< endl;
        }else {
            ConnectionToAP = l;
        }

    }
}

// *****************************************************************
// 3. functions on the application layers
// *****************************************************************

bool AppBusDataCollectionTCP::startApplication()
{
    // this function is like 'main fuction'
    // here we can start timers
    if (!Control_Task_Timer) {
        // we are programming a message called 'controlTimer' it start a timer of 1 second,
        // when this time finish it sent himself the message to 'handleMessage(cMessage *msg)'
        Control_Task_Timer = new cMessage("Check_Tasks");
        scheduleAt(simTime() + SimTime(6, SIMTIME_S), Control_Task_Timer); // the GW REQUIRE MORE TIME TO (1s) TO RECOVER INITIALITATION VARIABLES VALUES
    }
    return true;
}

bool AppBusDataCollectionTCP::stopApplication()
{
    if (Control_Task_Timer) {
        cancelAndDelete(Control_Task_Timer);
        Control_Task_Timer = nullptr;
    }

    // Llama a la función stopApplication base
    veins::VeinsInetApplicationBase::stopApplication();
    return true;
}

