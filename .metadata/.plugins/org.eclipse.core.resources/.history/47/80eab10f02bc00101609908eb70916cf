<config>
    <!-- eNodeBs -->
    <interface hosts="eNodeB*" names="cellular" address="10.x.x.x" netmask="255.255.0.0"/>
    <!-- AP nodes"/-->
    <interface hosts="ap[*]" names="wlan0" address="192.168.0.x" netmask="255.255.255.254"/>
    <!-- Assign 15.x.x.x addresses to all other interfaces -->
    <interface hosts="*" address="15.x.x.x" netmask="255.255.255.0"/>
</config>