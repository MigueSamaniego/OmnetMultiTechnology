*.bus[*].wlan[*].radio.antenna.mobility.offsetZ = 1.5m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMinX = 0m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMaxX = 0m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMinY = 0m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMaxY = 0m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMinZ = 0m
*.bus[*].wlan[*].radio.antenna.mobility.constraintAreaMaxZ = 0m
*.bus[*].wlan[*].mgmt.typename = "Ieee80211MgmtSta"
*.bus[*].wlan[*].mac.typename = "Ieee80211MacM"
*.bus[*].wlan[*].agent.typename = "Ieee80211AgentSta"
*.bus[*].wlan[*].agent.defaultSsid = "Spintel"
*.bus[*].wlan[*].agent.activeScan = true
*.bus[*].wlan[*].agent.channelsToScan = "3"

# Vehilces cellular interface 
*.bus[*].cellularNic.channelModel[*].tolerateMaxDistViolation = true


