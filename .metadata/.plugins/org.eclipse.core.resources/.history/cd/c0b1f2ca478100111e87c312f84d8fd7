# Example simulation for integrating veins (http://veins.car2x.org/) with Simu5G
# 
# Requirements:
#       You need to enable the feature "Simu5G Cars" for this simulation
#       (Project->Properties->OMNeT++->Project Features)
#
#       You need to import the "veins" project and its subproject
#       "veins_inet" in your workspace.
[General]
cmdenv-express-mode = true
cmdenv-autoflush = true
image-path = ../../images
network = simulations.BusCosenza.cars.HighwayTCP

#output-vector-file = "${resultdir}/${configname}-${iterationvarsf}-${repetition}.vec"
#output-scalar-file = "${resultdir}/${configname}-${iterationvarsf}-${repetition}.sca"

#output-vector-file = "${resultdir}/${iterationvarsf}/${configname}-${repetition}.vec"
#output-scalar-file = "${resultdir}/${iterationvarsf}/${configname}-${repetition}.sca"

#output-vector-file = "${resultdir}/model/${inifile}/${configname}-${repetition}.vec"
#output-scalar-file = "${resultdir}/model/${inifile}/${configname}-${repetition}.sca"

# Las carpetas serán dinámicas, pero los archivos siempre se llamarán igual



##########################################################
#            Simulation parameters                       #
##########################################################

debug-on-errors = true
record-eventlog = false
print-undisposed = false

sim-time-limit = 4000s#3500s(Normal) // 5500(traffic)

**.scalar-recording = true
**.vector-recording = true # attetion!!!! active to see the variables vector type.
**.app.*.vector-recording = true # also this
**.routingRecorder.enabled = false

**.app[*].inputBufferSize.result-recording-modes = +vector
**.app[*].outputBufferSize.result-recording-modes = +vector
**.app[*].sdcardBufferSize.result-recording-modes = +vector



*.playgroundSizeX = 10989m
*.playgroundSizeY = 19063m
*.playgroundSizeZ = 50m

##########################################################
# Annotation parameters                                  #
##########################################################
*.annotations.draw = true


##########################################################
# Obstacle parameters                                    #
##########################################################
*.obstacles.obstacles = xmldoc("./config.xml", "//AnalogueModel[@type='SimpleObstacleShadowing']/obstacles")


##########################################################
#            VeinsManager parameters                     #
##########################################################
*.veinsManager.host = "localhost"

#*.veinsManager.moduleType = "src.node_bus.cars.BusGW"

# 1. Ambos usan BusGW, porque sabemos que ese módulo sí existe y funciona
*.veinsManager.moduleType = "CONSORZIO_AUTOLINEE_DUE=src.node_bus.cars.BusGW car_private=src.node_bus.cars.BusGW car_private2=src.node_bus.cars.BusGW"

# 2. Los separamos por nombre para tratarlos de forma distinta
*.veinsManager.moduleName = "CONSORZIO_AUTOLINEE_DUE=bus car_private=trafficCar car_private2=trafficCar"

# 3. La cadena vacía para evitar errores del parser
*.veinsManager.moduleDisplayString = ""

#*.veinsManager.moduleName = "bus"
*.veinsManager.launchConfig = xmldoc("cosenza.launchd.xml")
*.veinsManager.updateInterval = 0.1s
 
##########################################################
#                      Mobility                          #
##########################################################
*.bus[*].mobility.typename = "src.node_bus.apps.VeinsInetMobility"

############### IPv4 configurator LET #################
*.configurator.config = xmldoc("./demo.xml")
*.configurator.dumpAddresses = true
*.configurator.dumpRoutes = true
*.configurator.verbose = true

#############################################################
#					interface wifi BUS						#
#############################################################
*.bus[*].ipv4.configurator.typename = "HostAutoConfiguratorM"
*.bus[*].ipv4.configurator.interfaces = "cellular lo0 wlan0"
*.bus[*].ipv4.configurator.addressBase = "10.0.0.1"
*.bus[*].ipv4.configurator.netmask = "255.255.0.0"
*.bus[*].ipv4.configurator.addressBaseWlan = "192.168.0.1"
*.bus[*].ipv4.configurator.netmaskWlan  = "255.255.0.0"

##########################################################
#              CONFIGURATION APP AND RADIO               #
##########################################################

# Vehilces app configuration 
*.bus[*].numWlanInterfaces = 1
*.bus[*].numApps = 1
*.bus[*].app[0].typename = "src.node_bus.apps.AppBusTCP_R_StateM_B"
#*.bus[*].app[0].typename = "src.node_bus.apps.AppBusTCP_R_StateM"
*.bus[*].app[0].interface = "wlan0"
*.bus[*].hasTcp = true 	# -->--->--->--> dont forget that TCP it must available on bus --------------

# Vehicles without interface wlan
*.trafficCar[*].numWlanInterfaces = 0
*.trafficCar[*].hasTcp = false
*.trafficCar[*].cellularNic.typename = ""
*.trafficCar[*].numApps = 1
*.trafficCar[*].app[0].typename = "inet.applications.pingapp.PingApp"
*.trafficCar[*].masterId = 0
*.trafficCar[*].mobility.typename = "src.node_bus.apps.VeinsInetMobility"



# Vehilces WIFI interface 
*.bus[*].wlan[*].opMode = "n(mixed-2.4Ghz)"
*.bus[*].wlan[*].radio.typename = "Ieee80211DimensionalRadio"
*.bus[*].wlan[*].radio.bandName = "2.4 GHz"
*.bus[*].wlan[*].radio.channelNumber = 3
*.bus[*].wlan[*].radio.transmitter.power = 0.20mW
