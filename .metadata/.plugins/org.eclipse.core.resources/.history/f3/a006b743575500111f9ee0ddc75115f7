<config>
    <!-- eNodeBs -->
    <interface hosts="eNodeB*" names="cellular" address="10.x.x.x" netmask="255.255.0.0"/>
    <!-- AP nodes"
    <interface hosts="ap[*]" names="wlan0" address="192.168.x.x" netmask="255.255.0.0"/>
    /-->
    <!-- Assign 15.x.x.x addresses to all other interfaces -->
    <interface hosts="*" address="15.x.x.x" netmask="255.255.0.0"/>
    
    <!-- Routing fix for WIFI packets /-->
    <route hosts="server" destination="192.168.0.0" netmask="255.255.0.0" gateway="router"/>
    <route hosts="router" destination="192.168.0.0" netmask="255.255.0.0" interface="eth0"/>
    
    <!-- Routing fix for cellular packets /-->
    <route hosts="server" destination="10.0.0.0" netmask="255.255.0.0" gateway="router"/>
    <route hosts="router" destination="10.0.0.0" netmask="255.255.0.0" gateway="pgw"/>
    
    <!-- Routing fix for packets on AP /-->
    <route hosts="ap[*]" destination="0.0.0.0" netmask="0.0.0.0" interface="eth0"/>
    <!-- <route hosts="ap[*]" destination="192.168.0.0" netmask="255.255.0.0" interface="wlan0"/> /-->
    
</config>