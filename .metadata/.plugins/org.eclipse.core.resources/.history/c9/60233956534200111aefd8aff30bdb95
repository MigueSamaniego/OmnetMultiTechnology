void AppBusDataCollectionTCP_R::socketPeerClosed(inet::TcpSocket *socket) {
    if (socket->getState() == inet::TcpSocket::CONNECTED) socket->close();
    socket_ready = false;
    socket_state_close = true; // start cooldown
    count_reTX = 0;
}

