std::string AppBusDataCollectionTCP_R::buildDataString(const std::vector<double>& values)
{

    std::ostringstream oss;

    // tiempo simulado + offset real
    std::time_t simTimestamp = startTime + (long)simTime().dbl();

    std::tm* tm_info = std::localtime(&simTimestamp);

    oss << std::put_time(tm_info, "%Y-%m-%d-%H-%M-%S");

    // add dynamic values
    for (size_t i = 0; i < values.size(); i++) {
        if (i < 2) { // lat y lon
            oss << "/" << std::fixed << std::setprecision(5) << values[i];
        } else {
            oss << "/" << std::fixed << std::setprecision(2) << values[i];
        }
    }

    oss << "/$";

    return oss.str();
}


